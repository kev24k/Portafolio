<button
	id="themeToggle"
	type="button"
	class="no-print inline-flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-ink/5 hover:text-ink"
	aria-label="Cambiar a modo oscuro"
>
	<!-- Luna (se muestra en modo claro) -->
	<svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
	</svg>
	<!-- Sol (se muestra en modo oscuro) -->
	<svg class="hidden size-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2m-7.07-2.93 1.41-1.41m11.32-11.32 1.41-1.41M2 12h2m16 0h2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41"></path>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const button = document.getElementById("themeToggle") as HTMLButtonElement;

	function syncLabel() {
		const dark = root.classList.contains("dark");
		button.setAttribute("aria-label", dark ? "Cambiar a modo claro" : "Cambiar a modo oscuro");
	}

	syncLabel();

	button.addEventListener("click", () => {
		const dark = root.classList.toggle("dark");
		localStorage.setItem("theme", dark ? "dark" : "light");
		syncLabel();
	});
</script>
