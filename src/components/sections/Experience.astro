---
import Section from "../Section.astro";
import { work } from "@cv";
import { formatMonthYear } from "@/utils/dates";
---

<Section id="experiencia" title="Experiencia">
	<ol class="divide-y divide-line border-y border-line">
		{
			work.map(({ name, startDate, endDate, position, summary, responsibilities, achievements, url, skills, location, location_type }) => (
				<li data-reveal="left" class="grid gap-3 py-8 md:grid-cols-12 md:gap-8">
					<div class="text-[15px] text-muted md:col-span-3">
						<p class="font-medium text-ink">
							<time datetime={startDate}>{formatMonthYear(startDate)}</time> – {endDate ? <time datetime={endDate}>{formatMonthYear(endDate)}</time> : "Presente"}
						</p>
						<p>{[location, location_type].filter(Boolean).join(", ")}</p>
					</div>

					<div class="relative md:col-span-9 md:pl-10">
						<!-- Línea de tiempo: se rellena de naranja al avanzar el scroll -->
						<span class="timeline no-print absolute bottom-[-2rem] left-0 top-2 hidden w-px bg-line md:block" aria-hidden="true">
							<span class="timeline-fill absolute inset-0 origin-top bg-gradient-to-b from-accent to-wine"></span>
						</span>
						<span class:list={["no-print absolute -left-[5px] top-2 hidden size-[11px] rounded-full border-2 border-paper md:block", endDate ? "bg-muted/60" : "bg-accent"]} aria-hidden="true">
							{!endDate && <span class="absolute inset-0 animate-ping rounded-full bg-accent/60 motion-reduce:hidden" />}
						</span>
						<h3 class="text-[21px] font-semibold leading-snug tracking-[-0.01em]">
							{position},{" "}
							{url ? (
								<a href={url} target="_blank" rel="noopener noreferrer" class="text-accent-ink underline decoration-accent/30 underline-offset-4 transition-colors hover:decoration-accent">
									{name}
								</a>
							) : (
								name
							)}
						</h3>
						<p class="mt-2 max-w-[64ch] text-muted">{summary}</p>

						{(responsibilities?.length || achievements?.length) && (
							<details class="group mt-4 max-w-[64ch]">
								<summary class="no-print inline-flex cursor-pointer list-none items-center gap-1.5 text-[15px] font-medium text-ink [&::-webkit-details-marker]:hidden">
									<span class="group-open:hidden">Ver responsabilidades y logros</span>
									<span class="hidden group-open:inline">Ocultar detalles</span>
									<svg class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="6 9 12 15 18 9" />
									</svg>
								</summary>
								<div class="mt-4 grid gap-5 sm:grid-cols-2">
									{responsibilities?.length && (
										<div>
											<h4 class="mb-2 text-[15px] font-semibold">Responsabilidades</h4>
											<ul class="space-y-2 text-[15px] text-muted">
												{responsibilities.map((item) => <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:rounded-full before:bg-line">{item}</li>)}
											</ul>
										</div>
									)}
									{achievements?.length && (
										<div>
											<h4 class="mb-2 text-[15px] font-semibold">Logros</h4>
											<ul class="space-y-2 text-[15px] text-muted">
												{achievements.map((item) => <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:rounded-full before:bg-accent">{item}</li>)}
											</ul>
										</div>
									)}
								</div>
							</details>
						)}

						{skills?.length && (
							<ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías usadas">
								{skills.map((skill) => <li class="tag">{skill}</li>)}
							</ul>
						)}
					</div>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.timeline-fill {
		transform: scaleY(0);
	}
	@supports (animation-timeline: view()) {
		.timeline-fill {
			animation: fill-line linear both;
			animation-timeline: view();
			animation-range: entry 40% cover 60%;
		}
		@keyframes fill-line {
			to {
				transform: scaleY(1);
			}
		}
	}
	@supports not (animation-timeline: view()) {
		.timeline-fill {
			transform: scaleY(1);
			opacity: 0.35;
		}
	}
	details[open] > div {
		animation: open-details 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	@keyframes open-details {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
	}
</style>
