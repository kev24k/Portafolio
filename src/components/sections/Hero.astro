---
import { basics } from "@cv";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import type { Component } from "@/types";

const { name, headline, image, location, profiles, phone, email, summary } = basics;
const { city, region } = location;

// El titular se anima palabra por palabra
const headlineWords = headline.split(" ");

const SOCIAL_ICONS: Record<string, Component> = {
	GitHub,
	LinkedIn,
};
---

<section id="inicio" class="grid items-center pb-20 pt-10 md:pt-20 lg:grid-cols-12 lg:gap-10">
	<div class="min-w-0 lg:col-span-8">
		<p data-rise class="no-print flex flex-wrap items-center gap-x-3 gap-y-1 text-[15px] text-muted">
			<span class="inline-flex items-center gap-2 font-medium text-ink">
				<span class="relative flex size-2" aria-hidden="true">
					<span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden"></span>
					<span class="relative inline-flex size-2 rounded-full bg-accent"></span>
				</span>
				Disponible para proyectos
			</span>
		</p>

		<!-- Móvil: la foto flota a la derecha y el titular la rodea -->
		<img
			src={image}
			alt=""
			width="572"
			height="1024"
			class="mobile-photo float-right ml-3 mt-9 aspect-square w-[64px] min-[360px]:ml-4 min-[360px]:w-[92px] rounded-2xl bg-wine object-cover object-[50%_20%] shadow-[0_0_36px_rgba(var(--accent),0.35)] sm:w-[132px] lg:hidden"
		/>

		<h1 class="no-print mt-8 max-w-[17ch] text-[clamp(2.25rem,6.2vw,4.75rem)] min-[360px]:text-[clamp(2.5rem,6.2vw,4.75rem)] font-bold leading-[1.04] tracking-[-0.035em]">
			{
				headlineWords.map((word, i) => (
					<>
						<span class="word">
							<span style={`--i:${i}`}>{word}</span>
						</span>{" "}
					</>
				))
			}
		</h1>

		<p data-rise class="clear-both mt-8 max-w-[60ch] text-[18px] leading-relaxed text-muted">
			{summary}
		</p>

		<div data-rise class="no-print mt-10 flex flex-wrap items-center gap-3">
			<div class="flex flex-wrap gap-2 sm:gap-3">
				<a href={`mailto:${email}`} class="btn-primary">
					<Mail />
					Escríbeme
				</a>
				<a href="/cv" class="btn-ghost">Ver CV</a>
				<a href="/cv-en" class="btn-ghost" hreflang="en">CV en inglés</a>
			</div>
			<div class="flex gap-2 sm:ml-2">
				{
					profiles.map(({ network, url }) => {
						const Icon = SOCIAL_ICONS[network];
						return (
							<a href={url} class="icon-link" target="_blank" rel="noopener noreferrer" aria-label={`${network} de ${name}`}>
								{Icon && <Icon />}
							</a>
						);
					})
				}
				{
					phone && (
						<a href={`tel:${phone.replace(/\s/g, "")}`} class="icon-link" aria-label={`Llamar al ${phone}`}>
							<Phone />
						</a>
					)
				}
			</div>
		</div>
	</div>

	<figure class="photo no-print relative hidden w-full max-w-[320px] justify-self-end lg:col-span-4 lg:block">
		<!-- Halo con los colores de la foto y del logo -->
		<div class="halo pointer-events-none absolute -inset-6 rounded-[40px] opacity-70 blur-2xl motion-reduce:animate-none dark:opacity-60" aria-hidden="true"></div>
		<div class="photo-frame relative overflow-hidden rounded-3xl bg-wine">
			<img
				src={image}
				alt={`Retrato de ${name}`}
				width="572"
				height="1024"
				class="aspect-[4/5] w-full object-cover object-[50%_20%]"
				fetchpriority="high"
			/>
		</div>
		<figcaption class="absolute -left-5 bottom-6 inline-flex items-center gap-1.5 rounded-full bg-surface px-3 py-1.5 text-[13px] font-medium shadow-lg shadow-wine/10">
			<span class="size-1.5 rounded-full bg-accent"></span>
			{city}, {region}
		</figcaption>
	</figure>
</section>

<style>
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}
	@keyframes word-up {
		from {
			transform: translateY(105%);
		}
	}
	@keyframes unveil {
		from {
			clip-path: inset(100% 0 0 0 round 24px);
		}
		to {
			clip-path: inset(0 0 0 0 round 24px);
		}
	}
	@keyframes photo-zoom {
		from {
			transform: scale(1.18);
		}
	}

	/* Cada palabra sube desde detrás de una máscara */
	.word {
		display: inline-block;
		overflow: hidden;
		vertical-align: top;
		padding-bottom: 0.08em;
		margin-bottom: -0.08em;
	}
	.word > span {
		display: inline-block;
		animation: word-up 0.9s cubic-bezier(0.2, 0.75, 0.15, 1) both;
		animation-delay: calc(var(--i) * 55ms + 100ms);
	}

	[data-rise] {
		animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	p[data-rise]:first-child {
		animation-delay: 0ms;
	}
	p[data-rise]:not(:first-child) {
		animation-delay: 550ms;
	}
	div[data-rise] {
		animation-delay: 700ms;
	}

	.photo-frame {
		animation: unveil 1.1s cubic-bezier(0.7, 0, 0.2, 1) 200ms both;
	}
	.mobile-photo {
		animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 300ms both;
	}
	.photo-frame img {
		animation: photo-zoom 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 200ms both;
	}
	.photo figcaption {
		animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 1100ms both;
	}

	/* Gira el degradado, no la caja, para que el halo no deforme sus bordes */
	@property --halo-angle {
		syntax: "<angle>";
		initial-value: 0deg;
		inherits: false;
	}
	@keyframes halo-turn {
		to {
			--halo-angle: 360deg;
		}
	}
	.halo {
		background: conic-gradient(from var(--halo-angle), rgb(var(--wine)), rgb(var(--accent)), rgb(var(--amber)), rgb(var(--wine)));
		animation: halo-turn 12s linear infinite;
	}
</style>
