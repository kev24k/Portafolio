---
import Section from "../Section.astro";
import { education, certificates } from "@cv";
import { formatYear } from "@/utils/dates";
---

<Section id="educacion" title="Educación" className={Astro.props.className}>
	<ul class="space-y-6">
		{
			education.map(({ institution, startDate, endDate, area }, i) => (
				<li data-reveal style={`--d:${i * 90}ms`} class="flex items-baseline justify-between gap-6">
					<div>
						<h3 class="font-semibold leading-snug">{area}</h3>
						<p class="text-[15px] text-muted">{institution}</p>
					</div>
					<p class="shrink-0 text-[15px] tabular-nums text-muted">
						{formatYear(startDate)} – {formatYear(endDate)}
					</p>
				</li>
			))
		}
	</ul>

	{
		certificates.length > 0 && (
			<>
				<h3 class="mb-4 mt-10 text-[19px] font-semibold">Certificados</h3>
				<ul class="space-y-6">
					{certificates.map(({ name, date, issuer }, i) => (
						<li data-reveal style={`--d:${i * 90}ms`} class="flex items-baseline justify-between gap-6">
							<div>
								<p class="font-medium leading-snug">{name}</p>
								<p class="text-[15px] text-muted">{issuer}</p>
							</div>
							<p class="shrink-0 text-[15px] tabular-nums text-muted">{formatYear(date)}</p>
						</li>
					))}
				</ul>
			</>
		)
	}
</Section>
