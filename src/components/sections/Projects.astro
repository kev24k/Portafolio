---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../Section.astro";
import { projects } from "@cv";

// Las capturas viven en src/assets para que Astro genere varios tamaños (srcset); cv.json las nombra por archivo
const SHOTS = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.webp", { eager: true });
const shot = (file: string) => {
	const found = SHOTS[`/src/assets/projects/${file.replace(/^\//, "")}`];
	if (!found) throw new Error(`Falta la captura ${file} en src/assets/projects/`);
	return found.default;
};

// Los dos primeros proyectos se muestran destacados a ancho completo
const FEATURED = 2;

const items = projects.map((project) => {
	const screenshots = (project.images?.length ? project.images : project.image ? [project.image] : []).map(shot);
	const destination = project.url && project.url !== "/" && project.url !== "#" ? project.url : undefined;
	const host = destination ? new URL(destination).hostname.replace(/^www\./, "") : undefined;
	return { ...project, screenshots, destination, host };
});
---

<Section id="proyectos" title="Proyectos" className="no-print">
	<p slot="aside" class="text-[15px] text-muted">{projects.length} trabajos publicados y en desarrollo</p>

	<div class="grid gap-6 md:grid-cols-2 md:gap-8">
		{
			items.map(({ name, description, highlights, screenshots, destination, host }, index) => {
				// Si la cuadrícula queda impar, el último también ocupa el ancho completo
				const isOrphan = index === items.length - 1 && (items.length - FEATURED) % 2 === 1;
				const featured = index < FEATURED || isOrphan;
				const Card = destination ? "a" : "article";

				return (
					<Card
						href={destination}
						target={destination ? "_blank" : undefined}
						rel={destination ? "noopener noreferrer" : undefined}
						data-reveal="scale"
						data-spotlight
						style={`--d:${featured ? 0 : (index % 2) * 120}ms`}
						class:list={[
							"group flex flex-col overflow-hidden rounded-[20px] border border-line bg-surface transition-[border-color,box-shadow] duration-500",
							destination && "hover:border-accent/50 hover:shadow-2xl hover:shadow-wine/10",
							featured && "md:col-span-2 md:grid md:grid-cols-12",
						]}
					>
						<div
							class:list={[
								"relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-wine/[0.07] via-paper to-amber/[0.12] px-5 pt-5 sm:px-8 sm:pt-8",
								featured && "md:col-span-7 md:aspect-auto md:min-h-[380px]",
							]}
						>
							<div class="relative h-full overflow-hidden rounded-t-xl border border-b-0 border-line bg-surface transition-transform duration-700 ease-out group-hover:-translate-y-1.5">
								<div class="flex h-7 items-center border-b border-line px-3" aria-hidden="true">
									<span class="truncate text-[11px] text-muted">{host ?? name}</span>
								</div>
								{screenshots[0] ? (
									<Image
										src={screenshots[0]}
										widths={[480, 720, 1000, 1400]}
										sizes="(min-width: 1152px) 640px, (min-width: 768px) 55vw, calc(100vw - 5.5rem)"
										alt={`Captura de ${name}`}
										class="absolute inset-x-0 bottom-0 top-7 h-[calc(100%-1.75rem)] w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.05]"
										loading={index < FEATURED ? "eager" : "lazy"}
										decoding="async"
									/>
								) : (
									<div class="flex h-full items-center justify-center text-sm text-muted">Sin captura</div>
								)}
							</div>
							{screenshots[1] && (
								<div class="absolute bottom-0 right-5 h-[68%] w-[26%] translate-y-3 overflow-hidden rounded-t-[14px] border-[3px] border-b-0 border-ink bg-ink shadow-2xl transition-transform duration-700 ease-out group-hover:-translate-y-2 group-hover:-rotate-2 sm:right-8" aria-hidden="true">
									<Image src={screenshots[1]} widths={[160, 320]} sizes="(min-width: 768px) 170px, calc((100vw - 5.5rem) * 0.26)" alt="" class="size-full rounded-t-[11px] object-cover object-top" loading="lazy" decoding="async" />
								</div>
							)}
						</div>

						<div class:list={["flex flex-1 flex-col gap-4 p-6 sm:p-8", featured && "md:col-span-5 md:justify-center md:p-10"]}>
							<h3 class:list={["font-bold leading-tight tracking-[-0.02em]", featured ? "text-[26px] md:text-[30px]" : "text-[22px]"]}>{name}</h3>
							<p class="max-w-[52ch] text-muted">{description}</p>
							<ul class="flex flex-wrap gap-2" aria-label="Características">
								{highlights.map((highlight) => (
									<li class="tag">{highlight}</li>
								))}
							</ul>
							<p class="mt-auto pt-2 text-[15px] font-semibold">
								{destination ? (
									<span class="inline-flex items-center gap-1.5 text-accent-ink">
										Visitar {host}
										<svg class="size-4 transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
											<path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
										</svg>
										<span class="sr-only">(se abre en una pestaña nueva)</span>
									</span>
								) : (
									<span class="text-muted">Proyecto privado, disponible bajo solicitud</span>
								)}
							</p>
						</div>
					</Card>
				);
			})
		}
	</div>
</Section>
