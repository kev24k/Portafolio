---
interface Props {
	id?: string;
	title: string;
	className?: string;
}

const { id, title, className } = Astro.props;
---

<section id={id} class:list={["border-t border-line py-16 md:py-24", className]}>
	<header data-reveal class="mb-10 flex items-baseline justify-between gap-4">
		<h2 class="text-[28px] font-bold leading-tight tracking-[-0.02em] md:text-[34px]">{title}</h2>
		<slot name="aside" />
	</header>
	<slot />
</section>
